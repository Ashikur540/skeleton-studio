# Everything here is excluded from the build context sent to the Docker daemon.
# Smaller context = faster builds and fewer cache busts.

# dependencies / build output (reinstalled and rebuilt inside the image)
node_modules
.next
out
build
coverage

# vcs & CI
.git
.gitignore
.github

# local env — NEXT_PUBLIC_* values come in via --build-arg instead
.env
.env.*
!.env.example

# docker's own files (never needed inside the image)
Dockerfile
.dockerignore
docker-compose*.yml
deploy

# editor / OS junk
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# AI tooling / agent artifacts
.claude
.commandcode
AGENTS.md
CLAUDE.md
skills-lock.json

# docs & local-only assets
docs
inspiration
.vercel
.vercelignore

# tests (not run in the image build)
**/*.test.ts
**/*.test.tsx
vitest.config.ts
